<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="900.0" prefHeight="600.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.hall.HallManagementController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <!-- Top Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Verwaltung" styleClass="button-default" onAction="#handleBackToMenu" />
        <Label text="Hallen-Verwaltung" styleClass="header-label" />

        <Region HBox.hgrow="ALWAYS" />

        <Label text="Suche:" />
        <TextField fx:id="searchField" promptText="Halle / Hallenobjekt..." prefWidth="200.0" />

        <Button text="+ Neue Halle" styleClass="button-primary" onAction="#handleCreateNewHall" />
    </HBox>

    <Separator />

    <StackPane VBox.vgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
        <!-- Aufklappbare Baum-Tabelle -->
        <TreeTableView fx:id="treeTableView" showRoot="false" VBox.vgrow="ALWAYS">
            <columns>
                <TreeTableColumn fx:id="colName" text="Bezeichnung / Name" prefWidth="260.0" />
                <TreeTableColumn fx:id="colDescription" text="Beschreibung" prefWidth="260.0" />
                <TreeTableColumn fx:id="colSize" text="Maße (Breite × Höhe)" prefWidth="170.0" />
                <TreeTableColumn fx:id="colDefaultObjectSize" text="Std.-Objektmaße" prefWidth="150.0" />
                <TreeTableColumn fx:id="colObjectCount" text="Hallenobjekte (Anzahl)" prefWidth="170.0" />
                <TreeTableColumn fx:id="colUsage" text="Vorstellungen (Anzahl)" prefWidth="170.0" />
                <TreeTableColumn fx:id="colShape" text="Form" prefWidth="100.0" />
            </columns>
            <columnResizePolicy>
                <TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TreeTableView>
    </StackPane>
</VBox>
