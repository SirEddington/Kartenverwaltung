<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.hall.HallManagementController">

    <!-- Aktionen auf der Hallenliste (Header, Suche und Speichern liegen in der Shell) -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnDelete" text="Löschen" styleClass="button-danger" onAction="#handleDeleteHall" />
        <Button fx:id="btnCreate" text="+ Neue Halle" styleClass="button-primary" onAction="#handleCreateNewHall" />
    </HBox>

    <TableView fx:id="hallTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Name" prefWidth="200.0" />
            <TableColumn fx:id="colDescription" text="Beschreibung" prefWidth="220.0" />
            <TableColumn fx:id="colHallWidth" text="Saalbreite (m)" prefWidth="110.0" />
            <TableColumn fx:id="colHallHeight" text="Saallänge (m)" prefWidth="110.0" />
            <TableColumn fx:id="colDefaultObjectWidth" text="Std.-Objektbreite" prefWidth="110.0" />
            <TableColumn fx:id="colDefaultObjectHeight" text="Std.-Objekthöhe" prefWidth="110.0" />
            <TableColumn fx:id="colObjectCount" text="Hallenobjekte" prefWidth="100.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
