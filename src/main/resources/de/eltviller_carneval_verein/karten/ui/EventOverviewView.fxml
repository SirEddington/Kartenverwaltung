<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="900.0" prefHeight="600.0" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="de.eltviller_carneval_verein.karten.ui.EventOverviewController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <!-- Top Toolbar -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Menü" onAction="#handleBackToMenu" />
        <Label text="Event-Übersicht" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Label text="Suche:" />
        <TextField fx:id="searchField" promptText="Event / Vorstellung..." prefWidth="200.0" />
        
        <Button text="+ Neues Event" onAction="#handleCreateNewEvent" style="-fx-base: #28a745; -fx-text-fill: white;" />
    </HBox>

    <Separator />

    <StackPane VBox.vgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
        <!-- Aufklappbare Baum-Tabelle -->
		<TreeTableView fx:id="treeTableView" showRoot="false" VBox.vgrow="ALWAYS">
    		<columns>
        		<TreeTableColumn fx:id="colName" text="Bezeichnung / Name" prefWidth="300.0" />
        		<TreeTableColumn fx:id="colCategory" text="Kategorie" prefWidth="150.0" />
       			<TreeTableColumn fx:id="colStatus" text="Status / Details" prefWidth="250.0" />
    		</columns>
    		<columnResizePolicy>
        		<TreeTableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
    		</columnResizePolicy>
		</TreeTableView>
    </StackPane>
</VBox>