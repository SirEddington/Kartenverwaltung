<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import de.eltviller_carneval_verein.karten.ui.sales.HallPlanPane?>

<!-- Der Plan; was beschriftet ist, stellt das Menü "Anzeige" in der Fußzeile der Shell ein -->
<VBox spacing="8.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.sales.HallOverviewController">

    <StackPane VBox.vgrow="ALWAYS">
        <!-- Zoom (Mausrad) & Verschieben (Ziehen mit der rechten Maustaste) übernimmt die HallPlanPane -->
        <HallPlanPane fx:id="viewportPane"
                   style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5; -fx-background-color: transparent;">

            <!-- Hinweis, solange keine einzelne Vorstellung gewählt ist (Text und Sichtbarkeit setzt der Controller) -->
            <Label fx:id="lblHint" styleClass="subheader-label" mouseTransparent="true" />
        </HallPlanPane>

        <!-- Zielwahl beim Verschieben (KARV-140): nur sichtbar, solange sie läuft; Text und Knöpfe setzt der Controller.
             Die Leiste liegt über dem oberen Rand des Plans, statt ihn zu verkleinern: Sonst spränge der Ausschnitt, und
             das Kundenfenster, das dem Ausschnitt folgt, zoomte bei Beginn und Ende der Zielwahl -->
        <HBox fx:id="moveBar" spacing="10.0" alignment="CENTER_LEFT" visible="false" managed="false"
              StackPane.alignment="TOP_CENTER" maxHeight="-Infinity"
              style="-fx-background-color: white; -fx-border-color: #999999; -fx-border-width: 0 0 1 0; -fx-padding: 6 10 6 10;">
            <Label fx:id="lblMove" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnMoveGo" styleClass="button-primary" text="Verschieben…" onAction="#handleMoveGo" />
            <Button fx:id="btnMoveCancel" styleClass="button-default" text="Abbrechen" onAction="#handleMoveCancel" />
        </HBox>
    </StackPane>

    <!-- Legende der Sitze (KARV-26); der Controller füllt sie und zeigt sie nur mit "Barrierefreie Sitzdarstellung" -->
    <StackPane fx:id="legendSlot" alignment="CENTER_LEFT" />
</VBox>
