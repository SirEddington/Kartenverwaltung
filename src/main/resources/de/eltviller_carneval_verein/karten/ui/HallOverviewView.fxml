<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import de.eltviller_carneval_verein.karten.ui.sales.HallPlanPane?>

<!-- Zoom (Mausrad) & Verschieben (Ziehen mit der rechten Maustaste) übernimmt die HallPlanPane -->
<HallPlanPane fx:id="viewportPane" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="de.eltviller_carneval_verein.karten.ui.sales.HallOverviewController"
           style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5; -fx-background-color: transparent;">

    <!-- Hinweis, solange keine einzelne Vorstellung gewählt ist (Text und Sichtbarkeit setzt der Controller) -->
    <Label fx:id="lblHint" styleClass="subheader-label" mouseTransparent="true" />
</HallPlanPane>
