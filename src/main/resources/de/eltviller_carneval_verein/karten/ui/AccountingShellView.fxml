<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.eltviller_carneval_verein.karten.ui.StatusLabel?>

<VBox spacing="15.0" prefWidth="1000.0" prefHeight="700.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.accounting.AccountingShellController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <fx:define>
        <ToggleGroup fx:id="viewToggleGroup" />
    </fx:define>

    <!-- OBERER BEREICH: Header, unabhängig vom Kartenverkauf -->
    <!-- Wie in der Verkaufsshell: Beschriftungen über den Feldern, feste Elemente behalten ihre Breite, nur die Auswahlfelder schrumpfen -->
    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
        <Button text="← Menü" styleClass="button-default" onAction="#handleBackToMenu" minWidth="-Infinity" />

        <Label text="Abrechnung" styleClass="header-label" minWidth="-Infinity" />

        <Region HBox.hgrow="ALWAYS" />

        <VBox spacing="2.0" HBox.hgrow="SOMETIMES">
            <Label text="Event" styleClass="field-caption" />
            <ComboBox fx:id="eventComboBox" prefWidth="160.0" minWidth="100.0" maxWidth="Infinity" promptText="Event wählen..." />
        </VBox>
        <CheckBox fx:id="chkIncludeArchived" text="Archivierte einschließen" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </CheckBox>

        <VBox spacing="2.0" HBox.hgrow="SOMETIMES">
            <Label text="Vorstellung" styleClass="field-caption" />
            <ComboBox fx:id="presComboBox" prefWidth="160.0" minWidth="100.0" maxWidth="Infinity" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <RadioButton fx:id="btnViewCash" text="Kassenabgleich" toggleGroup="$viewToggleGroup" selected="true" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </RadioButton>
        <RadioButton fx:id="btnViewStats" text="Statistik" toggleGroup="$viewToggleGroup" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </RadioButton>

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnToggleEdit" styleClass="button-secondary" text="Bearbeiten" onAction="#toggleEditMode" minWidth="-Infinity" disable="true" />
    </HBox>

    <Separator />

    <!-- MITTLERER BEREICH: Kassenabgleich oder Statistik, je nach Auswahl oben -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />

    <Separator />

    <!-- UNTERER BEREICH: Identischer Footer -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <StatusLabel />
        <Region HBox.hgrow="ALWAYS" />
        <SplitMenuButton fx:id="btnExport" styleClass="button-secondary" text="Exportieren" />
        <Button fx:id="btnSave" styleClass="button-primary" text="Speichern" prefWidth="100.0" onAction="#handleSave" />
    </HBox>
</VBox>
