<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.eltviller_carneval_verein.karten.ui.StatusLabel?>

<VBox spacing="15.0" prefWidth="1000.0" prefHeight="700.0" 
      xmlns="http://javafx.com/javafx/17" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="de.eltviller_carneval_verein.karten.ui.sales.TicketShellController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <fx:define>
        <ToggleGroup fx:id="viewToggleGroup" />
    </fx:define>

    <!-- OBERER BEREICH: Identischer Header -->
    <!-- Die Beschriftungen der Felder stehen über den Feldern (kosten keine Breite). Feste Elemente (Titel, Knöpfe, Radiobuttons,
         Checkbox) behalten ihre volle Breite (minWidth -Infinity), nur die Auswahlfelder und die Suche dürfen schrumpfen. -->
    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
        <Button text="← Menü" styleClass="button-default" onAction="#handleBackToMenu" minWidth="-Infinity" />

        <Label  fx:id="lblHeader" text="Kartentabelle" styleClass="header-label" minWidth="-Infinity" />

        <Region HBox.hgrow="ALWAYS" />

        <VBox spacing="2.0" HBox.hgrow="SOMETIMES">
            <Label text="Event" styleClass="field-caption" />
            <ComboBox fx:id="eventComboBox" prefWidth="160.0" minWidth="100.0" maxWidth="Infinity" promptText="Event wählen..." />
        </VBox>

        <VBox spacing="2.0" HBox.hgrow="SOMETIMES">
            <Label text="Vorstellung" styleClass="field-caption" />
            <ComboBox fx:id="presComboBox" prefWidth="160.0" minWidth="100.0" maxWidth="Infinity" />
        </VBox>

        <VBox spacing="2.0" HBox.hgrow="SOMETIMES">
            <Label text="Suche" styleClass="field-caption" />
            <TextField fx:id="searchField" prefWidth="160.0" minWidth="90.0" maxWidth="Infinity" promptText="Suche..." />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- Toggle-Buttons zum Umschalten der Mitte -->
        <RadioButton fx:id="btnTableView" text="Tabelle" toggleGroup="$viewToggleGroup" selected="true" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </RadioButton>
        <RadioButton fx:id="btnHallView" text="Saalansicht" toggleGroup="$viewToggleGroup" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </RadioButton>

        <CheckBox fx:id="chkSalesMode" text="Verkaufsmodus" onAction="#toggleSalesMode" minWidth="-Infinity">
            <padding><Insets bottom="6.0" /></padding>
        </CheckBox>

        <Button fx:id="btnToggleEdit" styleClass="button-secondary" text="Bearbeiten" onAction="#toggleEditMode" minWidth="-Infinity" />
    </HBox>
    
    <Separator />

    <!-- MITTLERER BEREICH: Wechselnder Inhalt -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />

    <Separator />

    <!-- UNTERER BEREICH: Identischer Footer -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <!-- Beschriftungen des Saalplans; immer aktiv, auch vor der Saalansicht (befüllt der Controller) -->
        <MenuButton fx:id="menuDisplay" text="Anzeige" styleClass="button-secondary" />
        <StatusLabel />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSave" styleClass="button-primary" text="Speichern" prefWidth="100.0" onAction="#handleSave" />
    </HBox>
</VBox>