<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="700.0" prefHeight="550.0" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="de.eltviller_carneval_verein.karten.ui.EventEditController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Event-Übersicht" onAction="#handleBackToEventOverview" />
        <Label text="Event-Details" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
        
        <Region HBox.hgrow="ALWAYS" />
                
        <Button fx:id="btnToggleEdit" text="Bearbeiten" prefWidth="90.0" onAction="#toggleEditMode"/>
    </HBox>

    <Separator />

<!-- Tabellen nebeneinander: Events und Vorstellungen -->
    <HBox fx:id="eventPerfHBox" spacing="10.0" minHeight="103">
        <!-- Event-Tabelle (links) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="eventTable">
                <columns>
                    <TableColumn fx:id="colEventName" prefWidth="90.0" text="Event" />
                    <TableColumn fx:id="colEventDesc" prefWidth="180.0" text="Beschreibung" />
                    <TableColumn fx:id="colEventArchived" prefWidth="60.0" text="Archiviert" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>

        <!-- Vorstellungs-Tabelle (rechts) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="presTable">
                <columns>
                    <TableColumn fx:id="colPresName" prefWidth="90.0" text="Vorstellung" />
                    <TableColumn fx:id="colPresDesc" prefWidth="180.0" text="Beschreibung" />
                    <TableColumn fx:id="colPresDate" prefWidth="60.0" text="Datum" />
                    <TableColumn fx:id="colPresTime" prefWidth="60.0" text="Uhrzeit" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>
    </HBox>

    <Separator />

<!-- Tabellen nebeneinander: Tisch und Sitze -->
    <HBox fx:id="tableSeatHBox" spacing="10.0">
        <!-- Tisch-Tabelle (links) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="tableTable">
                <columns>
                	<TableColumn fx:id="colTableNumber" prefWidth="60.0" text="Tisch" />
                	<TableColumn fx:id="colTableCategory" prefWidth="90.0" text="Kategorie" />
                	<TableColumn fx:id="colTableDesc" prefWidth="180.0" text="Beschreibung" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>

        <!-- Sitz-Tabelle (rechts) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="seatTable">
                <columns>
                	<TableColumn fx:id="colSeatNumber" prefWidth="60.0" text="Sitz" />
                	<TableColumn fx:id="colSeatComment" prefWidth="180.0" text="Kommentar" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>
    </HBox>

    <Separator />

<!-- Sitzdetails (3-Spalten-Layout) -->
    <Label text="Sitzdetails" style="-fx-font-weight: bold;" />
    <HBox spacing="20.0">
        <!-- Spalte Links: Personendaten -->
        <GridPane hgap="8.0" vgap="10.0" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Vorname:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="txtFirstName" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Nachname:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="txtLastName" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="E-Mail:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <TextField fx:id="txtMail" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        </GridPane>

        <!-- Spalte Mitte: Preis & Status -->
        <GridPane hgap="8.0" vgap="10.0" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Preis (€):" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Spinner fx:id="spnDoublePrice" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" />

            <Label text="Bezahlt:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <CheckBox fx:id="checkPaid" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <Label text="Abgeholt:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <CheckBox fx:id="checkCollected" GridPane.rowIndex="2" GridPane.columnIndex="1" />
        </GridPane>

        <!-- Spalte Rechts: Zusätze & Kommentar -->
        <GridPane hgap="8.0" vgap="10.0" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Rollstuhl:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <CheckBox fx:id="checkWheelchairAccessible" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Kommentar:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="txtComment" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>
    </HBox>

    <Region VBox.vgrow="ALWAYS" />

    <!-- Aktionen -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Speichern" onAction="#saveCurrentState" style="-fx-base: #28a745; -fx-text-fill: white;" />
    </HBox>
</VBox>