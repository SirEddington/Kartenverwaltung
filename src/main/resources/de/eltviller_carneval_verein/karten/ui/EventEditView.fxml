<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.eltviller_carneval_verein.karten.ui.StatusLabel?>

<VBox spacing="15.0" prefWidth="700.0" prefHeight="550.0" 
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="de.eltviller_carneval_verein.karten.ui.event.EventEditController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Event-Übersicht" styleClass="button-default" onAction="#handleBackToEventOverview" />
        <Label text="Event-Details" styleClass="header-label" />
        
        <Region HBox.hgrow="ALWAYS" />
                
        <Button fx:id="btnToggleEdit" styleClass="button-secondary" text="Bearbeiten" onAction="#toggleEditMode"/>
    </HBox>

    <Separator />

<!-- Tabellen nebeneinander: Events und Vorstellungen -->
    <HBox fx:id="eventPerfHBox" spacing="10.0" minHeight="103">
        <!-- Event-Tabelle (links) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="eventTable">
                <columns>
                    <TableColumn fx:id="colEventName" prefWidth="90.0" text="Event" />
                    <TableColumn fx:id="colEventDesc" prefWidth="180.0" text="Beschreibung" />
                    <TableColumn fx:id="colEventArchived" prefWidth="60.0" text="Archiviert" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>

        <!-- Vorstellungs-Tabelle (rechts) -->
        <StackPane HBox.hgrow="ALWAYS" style="-fx-border-color: #ccc; -fx-border-style: dashed; -fx-border-radius: 5;">
            <TableView fx:id="presTable">
                <columns>
                    <TableColumn fx:id="colPresName" prefWidth="90.0" text="Vorstellung" />
                    <TableColumn fx:id="colPresDesc" prefWidth="180.0" text="Beschreibung" />
                    <TableColumn fx:id="colPresDate" prefWidth="60.0" text="Datum" />
                    <TableColumn fx:id="colPresTime" prefWidth="60.0" text="Uhrzeit" />
                    <TableColumn fx:id="colPresHall" prefWidth="100.0" text="Halle" />
                    <TableColumn fx:id="colPresPlan" prefWidth="100.0" text="Bestuhlung" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>
    </HBox>

    <Separator />

<!-- Halle, Bestuhlung und Standardpreis der gewählten Vorstellung (Name, Datum, Zeit, Beschreibung stehen in der Tabelle) -->
    <Label fx:id="lblPresDetails" text="Vorstellung" />
    <GridPane fx:id="presDetails" hgap="8.0" vgap="10.0">
        <Label text="Halle:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
        <ComboBox fx:id="cmbPresHall" promptText="– keine Halle –" prefWidth="300.0" GridPane.rowIndex="0" GridPane.columnIndex="1" />

        <Label text="Bestuhlung:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
        <ComboBox fx:id="cmbPresPlan" promptText="Keine Bestuhlung" prefWidth="300.0" GridPane.rowIndex="1" GridPane.columnIndex="1" />

        <Label text="Standardpreis (€):" GridPane.rowIndex="2" GridPane.columnIndex="0" />
        <Spinner fx:id="spnPresPrice" editable="true" GridPane.rowIndex="2" GridPane.columnIndex="1" />
    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <!-- Aktionen -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <StatusLabel />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSave" text="Speichern" styleClass="button-primary" onAction="#saveCurrentState" />
    </HBox>
</VBox>