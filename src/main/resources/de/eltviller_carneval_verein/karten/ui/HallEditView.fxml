<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.eltviller_carneval_verein.karten.ui.StatusLabel?>

<VBox spacing="15.0" prefWidth="1000.0" prefHeight="700.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.hall.HallEditController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Hallen-Übersicht" styleClass="button-default" onAction="#handleBackToHallOverview" />
        <Label text="Hallen-Details" styleClass="header-label" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="btnToggleEdit" styleClass="button-secondary" text="Bearbeiten" onAction="#toggleEditMode" />
    </HBox>

    <Separator />

    <!-- Halleneigenschaften (2-Spalten-Layout) -->
    <Label text="Halleneigenschaften" />
    <HBox spacing="20.0">
        <GridPane hgap="8.0" vgap="10.0" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <TextField fx:id="txtName" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <Label text="Beschreibung:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <TextField fx:id="txtDescription" GridPane.rowIndex="1" GridPane.columnIndex="1" />
        </GridPane>

        <GridPane hgap="8.0" vgap="10.0" HBox.hgrow="ALWAYS">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" />
                <ColumnConstraints hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Saalbreite (cm):" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Spinner fx:id="spnHallWidth" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" />

            <Label text="Saalhöhe (cm):" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Spinner fx:id="spnHallHeight" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" />
        </GridPane>
    </HBox>

    <Separator />

    <!-- Hallenplan-Editor -->
    <fx:include fx:id="hallPlan" source="HallPlanView.fxml" VBox.vgrow="ALWAYS" />

    <Separator />

    <!-- Aktionen -->
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <StatusLabel />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnSave" text="Speichern" styleClass="button-primary" onAction="#handleSave" />
    </HBox>
</VBox>
