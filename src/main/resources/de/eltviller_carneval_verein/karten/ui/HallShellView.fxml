<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" prefWidth="1000.0" prefHeight="700.0"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="de.eltviller_carneval_verein.karten.ui.hall.HallShellController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <!-- OBERER BEREICH: Header -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button text="← Verwaltung" styleClass="button-default" onAction="#handleBackToManagement" />

        <Label fx:id="lblHeader" text="Hallenliste" styleClass="header-label" />

        <Region HBox.hgrow="ALWAYS" />

        <Label text="Halle:" />
        <ComboBox fx:id="hallComboBox" prefWidth="180.0" promptText="Halle wählen..." />

        <Label text="Suche:" />
        <TextField fx:id="searchField" prefWidth="180.0" promptText="Suche..." />

        <Region HBox.hgrow="ALWAYS" />

        <RadioButton fx:id="btnListView" text="Hallenliste" onAction="#showHallListView" selected="true" />
        <RadioButton fx:id="btnPlanView" text="Hallenplan" onAction="#showHallPlanView" />

        <Button fx:id="btnToggleEdit" styleClass="button-secondary" text="Bearbeiten" onAction="#toggleEditMode" />
    </HBox>

    <Separator />

    <!-- MITTLERER BEREICH: Wechselnder Inhalt -->
    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" />

    <Separator />

    <!-- UNTERER BEREICH: Footer -->
    <HBox spacing="10.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnSave" styleClass="button-primary" text="Speichern" prefWidth="100.0" onAction="#handleSave" />
    </HBox>
</VBox>
